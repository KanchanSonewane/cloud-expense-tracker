# =============================================================================
# Cloud-Based Expense Tracker: Environment Configuration
# B.Tech CSE Cloud Computing Lab - Environment Variables
# Copy this file to .env and fill in your actual AWS RDS and S3 credentials
# =============================================================================

# Server Settings
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=btech_cse_cloud_computing_lab_secure_jwt_token_key_2026
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Database Configuration (Amazon RDS for MySQL / Local MySQL)
# For AWS deployment: set DB_HOST to your RDS Endpoint URL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloud_expense_tracker
DB_USER=root
DB_PASSWORD=your_mysql_password

# -----------------------------------------------------------------------------
# AWS Cloud Storage Configuration (Amazon S3)
# For EC2 with IAM Role: Set AWS_USE_IAM_ROLE=true (no access keys needed in .env)
# For Local Development / Testing: Provide Access Key and Secret Key
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloud-expense-tracker-receipts-demo
AWS_USE_IAM_ROLE=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: Set to 'true' to allow local upload fallback if S3 bucket is unconfigured
# In production on AWS, this should be false so all receipts go to Amazon S3
ENABLE_LOCAL_STORAGE_FALLBACK=true
